NODE_ENV=development
PORT=8004
SERVICE_NAME=admin-service

# Same US database the customer, subscription, and US provider services use.
MONGODB_URL=mongodb://localhost:27017/neo-bank-us

# Wallet-server Mongo (separate DB). Needed for SEP / multi-chain wallets + txs.
# Copy from neo-bank-wallet-server MONGODB_URL (e.g. .../test-wallet).
WALLET_MONGODB_URL=mongodb://localhost:27017/test-wallet

# Must match the other services so operator and customer tokens verify with one secret.
JWT_ACCESS_SECRET=change-me-in-env
JWT_ACCESS_EXPIRES_IN=8h

LOG_LEVEL=debug
LOG_PRETTY=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=1
BODY_SIZE_LIMIT=10mb

# Created on startup when no admin with this email exists. Leave blank to skip.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FIRST_NAME=Admin
ADMIN_BOOTSTRAP_LAST_NAME=Operator

# Comma-separated client IPs. Empty disables the allowlist.
ADMIN_IP_ALLOWLIST=
